NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_FIXTURE_FALLBACK=false

DATABASE_URL=postgresql://agentpass:agentpass@localhost:5432/agentpass
