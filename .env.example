NODE_ENV=development

API_PORT=3001
API_BASE_URL=http://localhost:3001
WORKER_PORT=3002
VENDOR_SANDBOX_PORT=4202
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_FIXTURE_FALLBACK=false

DATABASE_URL=postgresql://agentpass:agentpass@localhost:5432/agentpass
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
BFF_SESSION_SECRET=local-dev-bff-session-secret-change-me-at-least-32-chars
MFA_REQUIRED_ROLES=OWNER,ADMIN,APPROVER

VAULT_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=agentpass-local
S3_ACCESS_KEY=agentpass
S3_SECRET_KEY=agentpass-secret
S3_FORCE_PATH_STYLE=true

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=AgentPass Local <agentpass@localhost>
DASHBOARD_BASE_URL=http://localhost:3000

WORKER_INTERNAL_TOKEN=local-worker-token-change-me

VENDOR_SANDBOX_URL=http://localhost:4202
API_ALLOWED_ORIGINS=http://localhost:3000
API_TRUSTED_PROXIES=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=1000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_INTERNAL_MAX=500
RATE_LIMIT_FILE_MAX=50
ENABLE_OPENAPI=false
ALLOW_LOCAL_PRODUCTION_DEPENDENCIES=false
LOG_LEVEL=debug

# Stripe billing. Use test-mode keys locally/staging and live-mode keys only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/app/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/app/settings?billing=cancelled
