{
  "name": "agentpass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker,vendor -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:vendor\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:vendor": "tsx watch apps/vendor-sandbox/src/main.ts",
    "dev:web": "pnpm --filter my-v0-project dev",
    "demo:local": "tsx scripts/demo-local.ts",
    "demo:reset": "tsx scripts/demo-local.ts --reset",
    "e2e:happy": "tsx scripts/e2e-happy-path.ts",
    "qa:click-path": "tsx scripts/dashboard-click-audit.ts",
    "qa:responsive": "tsx scripts/responsive-qa.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "stack:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile app down",
    "stack:logs": "docker compose -f infra/docker-compose.yml --profile app logs -f",
    "stack:hybrid:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build postgres redis minio mailpit migrate api worker vendor-sandbox",
    "stack:hybrid:logs": "docker compose -f infra/docker-compose.yml logs -f postgres redis minio mailpit api worker vendor-sandbox",
    "stack:hybrid:down": "docker compose -f infra/docker-compose.yml down",
    "dev:hybrid": "pnpm stack:hybrid:up && pnpm dev:web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx libs/database/src/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "lint": "eslint .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "build": "pnpm db:generate && pnpm typecheck && pnpm --filter my-v0-project build",
    "prod:check": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm audit:prod && pnpm --filter my-v0-project build",
    "db:deploy": "prisma migrate deploy",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "start:vendor": "tsx apps/vendor-sandbox/src/main.ts"
  },
  "prisma": {
    "seed": "tsx libs/database/src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
