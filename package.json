{
  "name": "agentpass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker,vendor -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:vendor\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:vendor": "tsx watch apps/vendor-sandbox/src/main.ts",
    "dev:web": "pnpm --filter my-v0-project dev",
    "demo:local": "tsx scripts/demo-local.ts",
    "demo:reset": "tsx scripts/demo-local.ts --reset",
    "e2e:happy": "tsx scripts/e2e-happy-path.ts",
    "test:frontend": "vitest run apps/web/**/*.spec.{ts,tsx}",
    "test:component": "vitest run apps/web/components/**/*.spec.tsx",
    "test:backend": "vitest run tests/**/*.spec.ts",
    "test:security": "vitest run tests/security/**/*.spec.ts tests/security-coverage.spec.ts",
    "test:regression": "vitest run tests/**/*.spec.ts apps/web/**/*.spec.{ts,tsx} libs/**/*.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "qa:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "qa:a11y": "tsx scripts/accessibility-audit.ts",
    "qa:all": "pnpm qa:click-path && pnpm qa:responsive && pnpm qa:a11y && pnpm qa:lighthouse",
    "load:api": "tsx scripts/load-api.ts",
    "load:workflow": "tsx scripts/load-workflow.ts",
    "qa:click-path": "tsx scripts/dashboard-click-audit.ts",
    "qa:responsive": "tsx scripts/responsive-qa.ts",
    "infra:up": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml down",
    "infra:logs": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml logs -f",
    "stack:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build",
    "stack:down": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml --profile app down",
    "stack:logs": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml --profile app logs -f",
    "stack:hybrid:up": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml --profile app up -d --build postgres redis minio mailpit migrate api worker vendor-sandbox",
    "stack:hybrid:logs": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml logs -f postgres redis minio mailpit api worker vendor-sandbox",
    "stack:hybrid:down": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://aegisweb.local} docker compose -f infra/docker-compose.yml down",
    "dev:hybrid": "pnpm stack:hybrid:up && pnpm dev:web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx libs/database/src/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "lint": "eslint .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:moderate": "pnpm audit --prod --audit-level moderate",
    "sbom": "pnpm dlx @cyclonedx/cyclonedx-npm --output-file sbom.cdx.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "backup:postgres": "tsx scripts/backup.ts",
    "restore:postgres": "tsx scripts/restore.ts",
    "build:api": "tsc -p apps/api/tsconfig.build.json && tsc-alias -p apps/api/tsconfig.build.json",
    "build:worker": "tsc -p apps/worker/tsconfig.build.json && tsc-alias -p apps/worker/tsconfig.build.json",
    "build:web": "pnpm --filter my-v0-project build",
    "build": "pnpm db:generate && pnpm typecheck && pnpm build:api && pnpm build:worker && pnpm build:web",
    "prod:check": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm audit:prod && pnpm build:api && pnpm build:worker && pnpm build:web",
    "launch:check": "tsx scripts/launch-readiness.ts",
    "db:deploy": "prisma migrate deploy",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "start:api:prod": "node dist/api/apps/api/src/main.js",
    "start:worker:prod": "node dist/worker/apps/worker/src/main.js",
    "start:vendor": "tsx apps/vendor-sandbox/src/main.ts"
  },
  "prisma": {
    "seed": "tsx libs/database/src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@lhci/cli": "^0.15.1",
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.61.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.10",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
